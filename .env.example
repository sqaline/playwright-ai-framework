# Playwright Automation Framework - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# Application Configuration
# ============================================
# REQUIRED: Set this to your application's base URL
QA_BASE_URL=https://your-app-url.com

# ============================================
# Test User Credentials
# ============================================

# Admin user (for admin-only features)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Regular authenticated user
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Guest/unauthenticated user (optional, for public access tests)
# TEST_GUEST_EMAIL=
# TEST_GUEST_PASSWORD=

# ============================================
# Test Email Configuration
# ============================================
# Used by test-data.ts to generate test emails
# TEST_EMAIL_PREFIX: Prefix for test emails (default: "test")
# TEST_EMAIL_DOMAIN: Domain for test emails (default: "test.com")
TEST_EMAIL_PREFIX=
TEST_EMAIL_DOMAIN=your-test-domain.com

# ============================================
# AI Agent Configuration (Optional)
# ============================================
# Used by llm-summarizer.ts for AI-powered test reports
# Choose your LLM provider and set corresponding API key

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-4-6

# LLM Provider Selection (openai | anthropic | other)
# LLM_PROVIDER=openai

# ============================================
# CI/CD Configuration (Optional)
# ============================================
# Set to true when running in CI/CD pipeline
CI=false
